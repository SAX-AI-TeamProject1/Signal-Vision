{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "프로젝트 셋업 (venv 생성 + 패키지 설치 + 검증)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "1. venv 생성 (.venv)",
                "2. 패키지 설치 (pip install -e .)",
                "3. 환경 검증 (import 확인)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "1. venv 생성 (.venv)",
            "type": "shell",
            "osx": {
                "command": "python3",
                "args": ["${workspaceFolder}/src/tools/setup_venv.py"]
            },
            "linux": {
                "command": "python3",
                "args": ["${workspaceFolder}/src/tools/setup_venv.py"]
            },
            "windows": {
                "command": "py",
                "args": ["${workspaceFolder}/src/tools/setup_venv.py"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "2. 패키지 설치 (pip install -e .)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": ["${workspaceFolder}/src/tools/install_deps.py"]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": ["${workspaceFolder}/src/tools/install_deps.py"]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": ["${workspaceFolder}/src/tools/install_deps.py"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "3. 환경 검증 (import 확인)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "${workspaceFolder}/src/tools/check_env.py"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "${workspaceFolder}/src/tools/check_env.py"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "${workspaceFolder}/src/tools/check_env.py"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 랜드마크 시각화 (capture)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 데이터 수집 (dataset)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 모델 학습 (training)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 실시간 추론 (inference)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--hand-confidence", "${input:handConfidence}"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--hand-confidence", "${input:handConfidence}"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--hand-confidence", "${input:handConfidence}"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 신뢰도 로그 기록 (발표 시각화용)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--hand-confidence", "${input:handConfidence}",
                    "--log-probs",
                    "--log-tag", "${input:logTag}",
                    "--log-delay", "${input:logDelay}",
                    "--log-seconds", "${input:logSeconds}"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--hand-confidence", "${input:handConfidence}",
                    "--log-probs",
                    "--log-tag", "${input:logTag}",
                    "--log-delay", "${input:logDelay}",
                    "--log-seconds", "${input:logSeconds}"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--hand-confidence", "${input:handConfidence}",
                    "--log-probs",
                    "--log-tag", "${input:logTag}",
                    "--log-delay", "${input:logDelay}",
                    "--log-seconds", "${input:logSeconds}"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 신뢰도 그래프 생성 (logs → PNG)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": ["-m", "src.tools.plot_probs"]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": ["-m", "src.tools.plot_probs"]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": ["-m", "src.tools.plot_probs"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 실시간 추론 + rosbridge 발행 (Signal-Simulation 연동)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--publish", "rosbridge",
                    "--rosbridge-url", "${input:rosbridgeUrl}",
                    "--hand-confidence", "${input:handConfidence}"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--publish", "rosbridge",
                    "--rosbridge-url", "${input:rosbridgeUrl}",
                    "--hand-confidence", "${input:handConfidence}"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--publish", "rosbridge",
                    "--rosbridge-url", "${input:rosbridgeUrl}",
                    "--hand-confidence", "${input:handConfidence}"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "시뮬 데모: Gazebo + 인식기 (Mac)",
            "type": "shell",
            "osx": {
                "command": "python3",
                "args": [
                    "${workspaceFolder}/../Signal-Simulation/tools/run_demo_mac.py"
                ]
            },
            "linux": {
                "command": "echo",
                "args": ["'이 태스크는 macOS 전용입니다 (Linux는 Signal-Simulation 쪽 데모 스크립트 준비 후 별도 태스크로 추가 예정)'"]
            },
            "windows": {
                "command": "Write-Host 'macOS 전용 태스크입니다 - Windows에서는 지원하지 않음'"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "날짜 헤더 자동 감시 (.py 저장 시)",
            "type": "shell",
            "osx": {
                "command": "python3",
                "args": ["${workspaceFolder}/src/tools/watch_py_saves.py", "${workspaceFolder}"]
            },
            "linux": {
                "command": "python3",
                "args": ["${workspaceFolder}/src/tools/watch_py_saves.py", "${workspaceFolder}"]
            },
            "windows": {
                "command": "py",
                "args": ["${workspaceFolder}/src/tools/watch_py_saves.py", "${workspaceFolder}"]
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": false
            },
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^ERROR: (.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Watching",
                    "endsPattern": "^Watching"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ],
    "inputs": [
        {
            "id": "signLabel",
            "type": "pickString",
            "description": "수집할 수신호 라벨 선택 (doc/design.md 기준 — src/dataset/collect.py의 KNOWN_LABELS와 동일하게 유지)",
            "options": ["stop", "slow", "come", "back", "left_go", "right_go", "idle"],
            "default": "stop"
        },
        {
            "id": "rosbridgeUrl",
            "type": "promptString",
            "description": "Signal-Simulation의 rosbridge 웹소켓 주소 (같은 리눅스 머신이면 기본값 그대로 두면 됨)",
            "default": "ws://localhost:9090"
        },
        {
            "id": "logTag",
            "type": "pickString",
            "description": "지금 수행할 수신호 (CSV 파일명·tag 열에 들어간다 — 라벨 하나씩 바꿔가며 반복 실행)",
            "options": ["stop", "slow", "come", "back", "left_go", "right_go", "idle"],
            "default": "stop"
        },
        {
            "id": "logDelay",
            "type": "promptString",
            "description": "기록 시작 전 준비 시간(초) — 카메라가 뜨고 확률이 나오기 시작한 뒤부터 카운트다운",
            "default": "3"
        },
        {
            "id": "logSeconds",
            "type": "promptString",
            "description": "기록할 시간(초) — 이만큼 기록하면 자동 종료된다",
            "default": "3"
        },
        {
            "id": "handConfidence",
            "type": "promptString",
            "description": "손 검출 신뢰도 임계값 (0~1, 기본 0.5) — 낮추면 장갑 등으로 윤곽이 흐릿해도 더 잘 잡지만 오검출·지터가 늘어남",
            "default": "0.5"
        }
    ]
}
