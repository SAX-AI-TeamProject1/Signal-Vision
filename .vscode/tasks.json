{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "프로젝트 셋업 (venv 생성 + 패키지 설치 + 검증)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "1. venv 생성 (.venv)",
                "2. 패키지 설치 (pip install -e .)",
                "3. 환경 검증 (import 확인)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "1. venv 생성 (.venv)",
            "type": "shell",
            "osx": {
                "command": "if [ -d .venv ]; then echo '.venv 이미 존재 - 건너뜀'; else if ! command -v python3.12 >/dev/null 2>&1; then echo 'Python 3.12 미설치 - Homebrew로 설치 시도'; if command -v brew >/dev/null 2>&1; then brew install python@3.12; else echo '[ERROR] Homebrew가 없어 자동 설치 불가 - https://www.python.org/downloads/release/python-31210/ 에서 수동 설치 필요'; exit 1; fi; fi; python3.12 -m venv .venv; fi"
            },
            "linux": {
                "command": "if [ -d .venv ]; then echo '.venv 이미 존재 - 건너뜀'; else if ! command -v python3.12 >/dev/null 2>&1; then echo '[ERROR] Python 3.12 미설치 - 배포판 패키지 관리자로 설치 필요 (예: apt install python3.12)'; exit 1; fi; python3.12 -m venv .venv; fi"
            },
            "windows": {
                "command": "if (Test-Path .venv) { Write-Host '.venv 이미 존재 - 건너뜀' } else { $has312 = $null -ne (py -0p 2>$null | Select-String '3\\.12'); if (-not $has312) { Write-Host 'Python 3.12 미설치 - winget으로 설치 시도'; winget install -e --id Python.Python.3.12 --accept-package-agreements --accept-source-agreements; } py -3.12 -m venv .venv }"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "2. 패키지 설치 (pip install -e .)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "pip",
                    "install",
                    "-e",
                    "."
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "pip",
                    "install",
                    "-e",
                    "."
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "pip",
                    "install",
                    "-e",
                    "."
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "3. 환경 검증 (import 확인)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-c",
                    "import cv2, mediapipe, numpy; print('OK | cv2', cv2.__version__, '| mediapipe', mediapipe.__version__, '| numpy', numpy.__version__)"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-c",
                    "import cv2, mediapipe, numpy; print('OK | cv2', cv2.__version__, '| mediapipe', mediapipe.__version__, '| numpy', numpy.__version__)"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-c",
                    "import cv2, mediapipe, numpy; print('OK | cv2', cv2.__version__, '| mediapipe', mediapipe.__version__, '| numpy', numpy.__version__)"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 랜드마크 시각화 (capture)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 데이터 수집 (dataset)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 모델 학습 (training)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 실시간 추론 (inference)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.inference.predict"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "시뮬 데모: Gazebo + 인식기 (Mac)",
            "type": "shell",
            "osx": {
                "command": "python3",
                "args": [
                    "${workspaceFolder}/../Mocap-Sim/tools/run_demo_mac.py"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "날짜 헤더 자동 감시 (.py 저장 시)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/watch_py_saves.sh",
            "args": [
                "${workspaceFolder}"
            ],
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": false
            },
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^ERROR: (.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Watching",
                    "endsPattern": "^Watching"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ],
    "inputs": [
        {
            "id": "signLabel",
            "type": "promptString",
            "description": "수집할 수신호 라벨 (자유 입력, 예: 멈춰)"
        }
    ]
}
