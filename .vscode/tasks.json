{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "프로젝트 셋업 (venv 생성 + 패키지 설치 + 검증)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "1. venv 생성 (.venv)",
                "2. 패키지 설치 (pip install -e .)",
                "3. 환경 검증 (import 확인)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "1. venv 생성 (.venv)",
            "type": "shell",
            "osx": {
                "command": "python3",
                "args": ["scripts/setup_venv.py"]
            },
            "linux": {
                "command": "python3",
                "args": ["scripts/setup_venv.py"]
            },
            "windows": {
                "command": "py",
                "args": ["scripts/setup_venv.py"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "2. 패키지 설치 (pip install -e .)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": ["scripts/install_deps.py"]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": ["scripts/install_deps.py"]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": ["scripts/install_deps.py"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "3. 환경 검증 (import 확인)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "scripts/check_env.py"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "scripts/check_env.py"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "scripts/check_env.py"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 랜드마크 시각화 (capture)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.capture.landmark_viewer"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 데이터 수집 (dataset)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.dataset.collect",
                    "--label",
                    "${input:signLabel}"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 모델 학습 (training)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.training.train"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 실시간 추론 (inference)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.inference.predict"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "실행: 실시간 추론 + 모션 트래킹 발행 (rosbridge → Signal-Simulation)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--publish", "rosbridge",
                    "--rosbridge-url", "${input:rosbridgeUrl}",
                    "--publish-pose"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--publish", "rosbridge",
                    "--rosbridge-url", "${input:rosbridgeUrl}",
                    "--publish-pose"
                ]
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "src.inference.predict",
                    "--publish", "rosbridge",
                    "--rosbridge-url", "${input:rosbridgeUrl}",
                    "--publish-pose"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "시뮬 데모: Gazebo + 인식기 (Mac)",
            "type": "shell",
            "osx": {
                "command": "python3",
                "args": [
                    "${workspaceFolder}/../Mocap-Sim/tools/run_demo_mac.py"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "날짜 헤더 자동 감시 (.py 저장 시)",
            "type": "shell",
            "osx": {
                "command": "${workspaceFolder}/scripts/watch_py_saves.sh",
                "args": ["${workspaceFolder}"]
            },
            "linux": {
                "command": "${workspaceFolder}/scripts/watch_py_saves.sh",
                "args": ["${workspaceFolder}"]
            },
            "windows": {
                "command": "Write-Host 'Watching (Windows에서는 지원하지 않음 - fswatch 필요, macOS/Linux 전용이라 건너뜀)'"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": false
            },
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^ERROR: (.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Watching",
                    "endsPattern": "^Watching"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ],
    "inputs": [
        {
            "id": "signLabel",
            "type": "pickString",
            "description": "수집할 수신호 라벨 선택 (doc/design.md 기준 — src/dataset/collect.py의 KNOWN_LABELS와 동일하게 유지)",
            "options": ["stop", "slow", "come", "back", "left_go", "right_go", "idle"],
            "default": "stop"
        },
        {
            "id": "rosbridgeUrl",
            "type": "promptString",
            "description": "Signal-Simulation(리눅스 VM)의 rosbridge 웹소켓 주소 — VM의 실제 IP로 바꿔서 입력 (예: ws://192.168.64.5:9090)",
            "default": "ws://localhost:9090"
        }
    ]
}
